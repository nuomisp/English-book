[Unit]
Description=English Companion Reminder Inbox
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=english-companion
Group=english-companion
WorkingDirectory=/opt/english-companion/server
EnvironmentFile=/etc/english-companion.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/english-companion/server/app.py
Restart=on-failure
RestartSec=5
StateDirectory=english-companion
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
MemoryMax=192M
CPUQuota=50%
TasksMax=64

[Install]
WantedBy=multi-user.target
